<?xml version="1.0" encoding="utf-8"?>
<!-- 개발(debug) 빌드에만 합쳐지는 부분. 출시(release) 빌드엔 adb 테스트 수신기가 없다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- adb 테스트용. DUMP 권한은 셸(adb)·시스템만 가져서 다른 앱은 못 부름. -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.siryul.talkbar.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
